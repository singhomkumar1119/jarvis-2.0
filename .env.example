# ==============================================================
# JARVIS AI — Self-Hosted Configuration
# ==============================================================

# --- AI Providers (Choose one or more) ---
# 1. Google Gemini (Recommended - Free & Fast Multimodal)
# Get your API key free at: https://aistudio.google.com/
GEMINI_API_KEY="your-gemini-api-key-here"

# 2. OpenAI API (Optional)
# OPENAI_API_KEY=""

# 3. Local Ollama (Optional - 100% Offline & Private on your machine)
# OLLAMA_BASE_URL="http://localhost:11434/v1"

# 4. NVIDIA NIM API (Optional)
# NVIDIA_API_KEY=""

# 5. Custom OpenAI-compatible Endpoint (Optional)
# AI_BASE_URL="http://localhost:8000/v1"
# AI_API_KEY=""
# AI_MODEL="custom-model"

# --- Security & Authentication ---
# Set a security PIN for Personal / Owner mode.
# Leave empty ("") for instant open access without a PIN prompt.
JARVIS_PIN=""

# --- Database Configuration (Hybrid: Supabase PostgreSQL or Local SQLite) ---
# Option A: Local SQLite (Default - zero configuration required)
DATABASE_URL="file:./data/jarvis.db"

# Option B: Supabase (Cloud PostgreSQL database with cross-device sync)
# Get your connection string from Supabase -> Project Settings -> Database -> Connection String -> URI:
# DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres"
# SUPABASE_DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres"

# Base application URL (for sitemaps and links)
APP_URL="http://localhost:3000"
